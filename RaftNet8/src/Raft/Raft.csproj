<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Raft.Net8</AssemblyName>
    <RootNamespace>Raft</RootNamespace>
    <Version>2.0.0</Version>
    <Description>Raft consensus for .NET 8 with checked DBreeze persistence, dynamic membership, ReadIndex and resumable snapshots.</Description>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DBreeze" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <InternalsVisibleTo Include="Raft.Tests" />
    <InternalsVisibleTo Include="Raft.Benchmarks" />
    <InternalsVisibleTo Include="Raft.Simulator" />
    <InternalsVisibleTo Include="Raft.CrashHarness" />
  </ItemGroup>
</Project>
